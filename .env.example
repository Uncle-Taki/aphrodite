# Aphrodite environment template.
# Copy this file to .env for local development and replace secrets before sharing
# or deploying. Keep APP_PORT=8080 with the current Docker Compose port mapping.

APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

JWT_SECRET=replace-with-at-least-32-byte-jwt-secret
JWT_ACCESS_TOKEN_TTL=24h
JWT_MIN_SECRET_BYTES=32
AUTH_BCRYPT_COST=10
SUPER_ADMIN_KEY=replace-with-super-admin-bootstrap-key

POST_TITLE_MAX_LENGTH=200
POST_CONTENT_MAX_LENGTH=100000
COMMENT_CONTENT_MAX_LENGTH=10000

USER_DEFAULT_LIMIT=20
USER_MAX_LIMIT=100
POST_DEFAULT_LIMIT=20
POST_MAX_LIMIT=100
COMMENT_DEFAULT_LIMIT=50
COMMENT_MAX_LIMIT=200

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aphrodite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aphrodite
POSTGRES_SSLMODE=disable
POSTGRES_MAINTAIN_ASSIGNMENT_INDEXES=false

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=aphrodite-media
MINIO_USE_SSL=false
MEDIA_PUBLIC_BASE_URL=http://localhost:9000
IMGPROXY_URL=http://localhost:8081
IMGPROXY_KEY=
IMGPROXY_SALT=

# Strapi content service
STRAPI_BASE_URL=http://strapi:1337
STRAPI_API_TOKEN=replace-with-a-scoped-server-token
STRAPI_TIMEOUT=3s
STRAPI_READY_TIMEOUT=30s
STRAPI_READY_POLL_INTERVAL=500ms
STRAPI_MAX_RETRIES=2
STRAPI_RETRY_BACKOFF=100ms
STRAPI_MAX_RETRY_BACKOFF=2s
STRAPI_DEFAULT_LOCALE=fa
STRAPI_FALLBACK_LOCALE=fa
STRAPI_CACHE_TTL=60s
STRAPI_WEBHOOK_SECRET=replace-with-strapi-webhook-secret
STRAPI_PORT=1337
STRAPI_APP_KEYS=replace-with-four-comma-separated-keys
STRAPI_API_TOKEN_SALT=replace-with-api-token-salt
STRAPI_ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
STRAPI_ENCRYPTION_KEY=replace-with-encryption-key
STRAPI_DB_NAME=aphrodite_strapi
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD=change-me-strapi-password
STRAPI_DB_SSL=false
STRAPI_TELEMETRY_DISABLED=true
STRAPI_UPLOAD_PROVIDER=aws-s3
MEDIA_PROVIDER=minio
MEDIA_ENDPOINT=minio:9000
MEDIA_REGION=us-east-1
MEDIA_ACCESS_KEY=minioadmin
MEDIA_SECRET_KEY=change-me-minio-secret
MEDIA_BUCKET=aphrodite-media
MEDIA_FORCE_PATH_STYLE=true

WORKER_CONCURRENCY=10
WORKER_QUEUE=default
CMS_SESSION_COOKIE=aphrodite_cms_session
CMS_SESSION_TTL=12h
CMS_SESSION_SECURE=false

CRYPTO_MASTER_KEY=replace-with-32-byte-master-key!

USAGE_RECONCILE_INTERVAL=0s
