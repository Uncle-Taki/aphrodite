{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": { "singularName": "brand", "pluralName": "brands", "displayName": "Brand" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 160, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "maxLength": 500, "pluginOptions": { "i18n": { "localized": true } } },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "website": { "type": "string" },
    "products": { "type": "relation", "relation": "oneToMany", "target": "api::product.product", "mappedBy": "brand" }
  }
}
