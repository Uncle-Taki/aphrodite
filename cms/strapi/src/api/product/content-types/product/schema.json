{
  "kind": "collectionType",
  "collectionName": "products",
  "info": { "singularName": "product", "pluralName": "products", "displayName": "Product" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 200, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "externalProductID": { "type": "string", "maxLength": 160 },
    "active": { "type": "boolean", "default": true },
    "brand": { "type": "relation", "relation": "manyToOne", "target": "api::brand.brand", "inversedBy": "products" },
    "affiliateLinks": { "type": "relation", "relation": "oneToMany", "target": "api::affiliate-link.affiliate-link", "mappedBy": "product" },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "mappedBy": "products" },
    "recipes": { "type": "relation", "relation": "manyToMany", "target": "api::recipe.recipe", "mappedBy": "products" }
  }
}
