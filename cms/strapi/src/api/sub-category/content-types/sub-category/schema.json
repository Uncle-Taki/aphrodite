{
  "kind": "collectionType",
  "collectionName": "sub_categories",
  "info": { "singularName": "sub-category", "pluralName": "sub-categories", "displayName": "Sub Category" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 120, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "name", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "maxLength": 500, "pluginOptions": { "i18n": { "localized": true } } },
    "mainCategory": { "type": "relation", "relation": "manyToOne", "target": "api::main-category.main-category", "inversedBy": "subCategories" },
    "articles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article", "mappedBy": "subCategories" },
    "recipes": { "type": "relation", "relation": "manyToMany", "target": "api::recipe.recipe", "mappedBy": "subCategories" }
  }
}
