HOST=0.0.0.0
PORT=1337
NODE_ENV=development

APP_KEYS=replace-with-four-comma-separated-keys
API_TOKEN_SALT=replace-with-api-token-salt
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret
TRANSFER_TOKEN_SALT=replace-with-transfer-token-salt
ENCRYPTION_KEY=replace-with-encryption-key

DATABASE_CLIENT=postgres
DATABASE_HOST=strapi-postgres
DATABASE_PORT=5432
DATABASE_NAME=aphrodite_strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fa
STRAPI_TELEMETRY_DISABLED=true

STRAPI_UPLOAD_PROVIDER=aws-s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=aphrodite-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/aphrodite-media
